# General Environment Configuration (test / prod)
COMPOSE_PROJECT_NAME=mytravels-test
ENVIRONMENT=test

# Database Configuration (PostgreSQL)
POSTGRES_PORT=5432
POSTGRES_DB=tripplanner
POSTGRES_USER=tripplanner
POSTGRES_PASSWORD=tripplanner

# Backend Configuration
BACKEND_PORT=8083
BACKEND_IMAGE=ghcr.io/raukros00/mytravels-backend:latest
# Obbligatoria, diversa per ogni ambiente. Generala con: openssl rand -hex 32
JWT_SECRET=
# Origini CORS consentite, separate da virgole. Vuota = default (prod, test, localhost:4200/4300).
# Se impostata sostituisce i default: elencare anche quelle che servono ancora.
CORS_ALLOWED_ORIGINS=
# true per loggare le query SQL (solo debug)
JPA_SHOW_SQL=false
# true per creare utenti/gruppi/viaggi demo all'avvio (solo locale/test, ignorato in prod)
SEED_DEMO_DATA=true

# Frontend Configuration
FRONTEND_PORT=8081
FRONTEND_IMAGE=ghcr.io/raukros00/mytravels-frontend:latest

# Copertine suggerite in base alla destinazione: "Access Key" dell'app su unsplash.com/developers (facoltativa)
UNSPLASH_ACCESS_KEY=

# Suggerimenti di città: username GeoNames con i "free web services" attivi (facoltativo)
GEONAMES_USERNAME=

# Notifiche push (Web Push), facoltative: senza queste tre variabili le push sono disattivate.
# Genera la coppia di chiavi UNA volta per ambiente con: npx web-push generate-vapid-keys
# (non cambiarle più: gli abbonamenti dei dispositivi sono legati alla chiave pubblica).
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# Contatto per i push service: mailto:indirizzo@dominio oppure https://dominio-del-sito
PUSH_VAPID_SUBJECT=
