{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit": "TZ=Europe/Rome ng test --watch=false --browsers=ChromeHeadless --include='src/app/**/*.utils.spec.ts'",
    "e2e:stack": "docker compose -f ../docker-compose.e2e.yml up -d --build --wait",
    "e2e:stack:down": "docker compose -f ../docker-compose.e2e.yml down",
    "e2e:serve": "ng serve --configuration development --host 127.0.0.1 --port 4300 --proxy-config proxy.e2e.conf.json",
    "cy:open": "cypress open --e2e",
    "e2e:ui": "../scripts/e2e-ui.sh",
    "cy:run": "cypress run --e2e",
    "e2e": "start-server-and-test e2e:serve http://127.0.0.1:4300 cy:run"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.6.1",
    "cypress": "^14.5.4",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.28",
    "start-server-and-test": "^2.1.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3"
  }
}
